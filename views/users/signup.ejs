<% layout("layouts/boilerplate") -%>
<% const activeRole = (typeof selectedRole !== "undefined" && selectedRole) ? selectedRole : "customer"; %>

<div class="row">
  <div class="col-8 offset-2">
    <form action="/signup" method="POST" novalidate class="needs-validation">
      <h2 class="mb-4 mt-4">Sign Up</h2>

      <!-- ACCOUNT TYPE -->
      <div class="mb-3">
        <label class="form-label"><b>Account Type</b></label>
        <div class="list-group">
          <label id="role-customer-label" class="list-group-item d-flex gap-2">
            <input
              class="form-check-input flex-shrink-0"
              type="radio"
              id="role-customer"
              name="role"
              value="customer"
              required
              <% if (activeRole === "customer") { %>checked<% } %>
            />
            <span>
              <strong>Customer</strong>
              <small class="d-block text-muted">Browse and book listings, leave reviews.</small>
            </span>
          </label>
          <label id="role-owner-label" class="list-group-item d-flex gap-2">
            <input
              class="form-check-input flex-shrink-0"
              type="radio"
              id="role-owner"
              name="role"
              value="owner"
              <% if (activeRole === "owner") { %>checked<% } %>
            />
            <span>
              <strong>Property / Venue Owner</strong>
              <small class="d-block text-muted">List and manage hotels, properties and event venues.</small>
              <small class="d-block text-muted">Owner accounts are approved by an admin before you can add listings.</small>
            </span>
          </label>
        </div>
        <div class="invalid-feedback">Please choose an account type.</div>
      </div>

      <!-- OWNER DETAILS BLOCK (shown only when owner is selected) -->
      <% if (activeRole === "owner") { %>
      <div id="owner-fields" class="mb-3">
        <div class="mb-3">
          <label for="business_name" class="form-label"><b>Business Name</b></label>
          <input
            type="text"
            id="business_name"
            name="business_name"
            placeholder="Enter business name"
            class="form-control"
            required
            minlength="2"
            maxlength="100"
          />
          <div class="invalid-feedback">Please enter a business name (2-100 characters).</div>
        </div>

        <div class="mb-3">
          <label for="business_type" class="form-label"><b>Business Type</b></label>
          <select id="business_type" name="business_type" class="form-select" required>
            <option value="">Select business type...</option>
            <% if (typeof BUSINESS_TYPES !== "undefined") { %>
              <% for (const [val, label] of Object.entries(BUSINESS_TYPES)) { %>
                <option value="<%= val %>"><%= label %></option>
              <% } %>
            <% } %>
          </select>
          <div class="invalid-feedback">Please select a business type.</div>
        </div>

        <div class="mb-3">
          <label for="phone" class="form-label"><b>Phone Number</b></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="+91XXXXXXXXXX"
            class="form-control"
            required
            pattern="^\+?[0-9]{10,15}$"
          />
          <div class="invalid-feedback">Please enter a valid phone number (10-15 digits).</div>
        </div>
      </div>
      <% } else { %>
      <div id="owner-fields" class="mb-3" style="display: none;">
        <div class="mb-3">
          <label for="business_name" class="form-label"><b>Business Name</b></label>
          <input
            type="text"
            id="business_name"
            name="business_name"
            placeholder="Enter business name"
            class="form-control"
            disabled
            minlength="2"
            maxlength="100"
          />
          <div class="invalid-feedback">Please enter a business name (2-100 characters).</div>
        </div>

        <div class="mb-3">
          <label for="business_type" class="form-label"><b>Business Type</b></label>
          <select id="business_type" name="business_type" class="form-select" disabled>
            <option value="">Select business type...</option>
            <% if (typeof BUSINESS_TYPES !== "undefined") { %>
              <% for (const [val, label] of Object.entries(BUSINESS_TYPES)) { %>
                <option value="<%= val %>"><%= label %></option>
              <% } %>
            <% } %>
          </select>
          <div class="invalid-feedback">Please select a business type.</div>
        </div>

        <div class="mb-3">
          <label for="phone" class="form-label"><b>Phone Number</b></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="+91XXXXXXXXXX"
            class="form-control"
            disabled
            pattern="^\+?[0-9]{10,15}$"
          />
          <div class="invalid-feedback">Please enter a valid phone number (10-15 digits).</div>
        </div>
      </div>
      <% } %>

      <!-- USERNAME -->
      <div class="mb-3">
        <label for="username" class="form-label"><b>Username</b></label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Enter username"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a username.</div>
      </div>

      <!-- EMAIL -->
      <div class="mb-3">
        <label for="email" class="form-label"><b>Email</b></label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Enter email"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a valid email.</div>
      </div>

      <!-- PASSWORD -->
      <div class="mb-3">
        <label for="password" class="form-label"><b>Password</b></label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter password"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a password.</div>
      </div>

      <button type="submit" class="btn btn-primary">Sign Up</button>
    </form>
  </div>
</div>
