<!-- views/dashboard/sidebar.ejs -->
<div class="card border-0 shadow-sm sticky-top" style="top: 80px;">
  <!-- User Profile Summary in Sidebar -->
  <div class="card-body text-center p-3 border-bottom">
    <% if (currentUser && currentUser.profilePictureUrl) { %>
      <img
        src="<%= currentUser.profilePictureUrl %>"
        alt="<%= currentUser.username %>"
        class="rounded-circle mb-2 shadow-sm"
        style="width: 70px; height: 70px; object-fit: cover;"
      />
    <% } else { %>
      <div
        class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2 shadow-sm"
        style="width: 70px; height: 70px; font-size: 1.75rem; font-weight: 600;"
      >
        <%= currentUser ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
      </div>
    <% } %>
    <h6 class="mb-1 fw-bold text-truncate"><%= currentUser ? currentUser.username : 'User' %></h6>
    <%
      const roleBadgeClasses = {
        customer: 'bg-info text-dark',
        owner:    'bg-primary',
        admin:    'bg-danger',
      };
      const roleLabels = {
        customer: 'Customer',
        owner:    'Owner',
        admin:    'Admin',
      };
    %>
    <span class="badge <%= roleBadgeClasses[currentUser.role] || 'bg-secondary' %>">
      <%= roleLabels[currentUser.role] || currentUser.role %>
    </span>
    <% if (currentUser.role === 'owner') { %>
      <div class="mt-1">
        <% const statusBadge = { pending: 'bg-warning text-dark', approved: 'bg-success', rejected: 'bg-danger' }; %>
        <span class="badge <%= statusBadge[currentUser.ownerStatus] || 'bg-secondary' %>" style="font-size: 0.75rem;">
          <%= currentUser.ownerStatus === 'approved' ? 'Approved' : (currentUser.ownerStatus === 'rejected' ? 'Rejected' : 'Pending Approval') %>
        </span>
      </div>
    <% } %>
  </div>

  <!-- Navigation Links -->
  <div class="list-group list-group-flush py-2">
    <% if (typeof sections !== 'undefined' && sections && sections.length) { %>
      <% for (const sec of sections) { %>
        <%
          const isActive = (typeof activeSection !== 'undefined' && activeSection === sec.key);
          const isDisabled = sec.enabled === false;
        %>
        <% if (isDisabled) { %>
          <div
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center text-muted disabled bg-light"
            style="cursor: not-allowed;"
          >
            <div>
              <i class="<%= sec.icon || 'fa-solid fa-circle' %> me-2"></i>
              <span><%= sec.label %></span>
            </div>
            <span class="badge bg-secondary" style="font-size: 0.7rem;">Soon</span>
          </div>
        <% } else { %>
          <a
            href="<%= sec.path %>"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= isActive ? 'active' : '' %>"
          >
            <div>
              <i class="<%= sec.icon || 'fa-solid fa-circle' %> me-2"></i>
              <span><%= sec.label %></span>
            </div>
            <% if (sec.key === 'approvals' && typeof pendingOwnerCount === 'number' && pendingOwnerCount > 0) { %>
              <span class="badge <%= isActive ? 'bg-light text-dark' : 'bg-danger' %> rounded-pill">
                <%= pendingOwnerCount %>
              </span>
            <% } %>
          </a>
        <% } %>
      <% } %>
    <% } %>
  </div>
</div>
