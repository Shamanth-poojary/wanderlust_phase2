<% layout("dashboard/layout") -%>

<div class="row g-4">
  <!-- Profile Summary Card -->
  <div class="col-12 col-lg-5">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-white border-bottom py-3">
        <h5 class="card-title mb-0 fw-bold">
          <i class="fa-solid fa-id-card me-2 text-primary"></i>Profile Details
        </h5>
      </div>
      <div class="card-body text-center p-4">
        <!-- Avatar -->
        <div class="mb-3 position-relative d-inline-block">
          <% if (user.profilePictureUrl) { %>
            <img
              src="<%= user.profilePictureUrl %>"
              alt="<%= user.username %>"
              class="rounded-circle shadow-sm border"
              style="width: 120px; height: 120px; object-fit: cover;"
            />
          <% } else { %>
            <div
              class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center shadow-sm"
              style="width: 120px; height: 120px; font-size: 3rem; font-weight: 600;"
            >
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
          <% } %>
        </div>

        <h4 class="fw-bold mb-1"><%= user.username %></h4>
        <p class="text-muted mb-2"><%= user.email %></p>

        <!-- Role Badge -->
        <%
          const roleBadgeClasses = {
            customer: 'bg-info text-dark',
            owner:    'bg-primary',
            admin:    'bg-danger',
          };
          const roleLabels = {
            customer: 'Customer',
            owner:    'Property / Venue Owner',
            admin:    'Administrator',
          };
        %>
        <div class="mb-3">
          <span class="badge <%= roleBadgeClasses[user.role] || 'bg-secondary' %> fs-6 px-3 py-2">
            <%= roleLabels[user.role] || user.role %>
          </span>
          <% if (user.role === 'owner') { %>
            <div class="mt-2">
              <%
                const statusBadges = {
                  pending:  'bg-warning text-dark',
                  approved: 'bg-success',
                  rejected: 'bg-danger',
                };
                const statusNames = {
                  pending:  'Approval Pending',
                  approved: 'Approved Owner',
                  rejected: 'Application Rejected',
                };
              %>
              <span class="badge <%= statusBadges[user.ownerStatus] || 'bg-secondary' %>">
                <%= statusNames[user.ownerStatus] || user.ownerStatus %>
              </span>
            </div>
          <% } %>
        </div>

        <hr />

        <!-- Profile Details List -->
        <ul class="list-group list-group-flush text-start">
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted"><i class="fa-solid fa-phone me-2"></i>Phone:</span>
            <span class="fw-semibold"><%= user.phone || 'Not provided' %></span>
          </li>
          <li class="list-group-item px-0">
            <span class="text-muted d-block mb-1"><i class="fa-solid fa-comment-dots me-2"></i>Bio:</span>
            <p class="mb-0 text-secondary fst-italic">
              <%= user.bio ? user.bio : 'No bio provided yet.' %>
            </p>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted"><i class="fa-solid fa-calendar me-2"></i>Member Since:</span>
            <span class="fw-semibold">
              <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : 'N/A' %>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Edit Profile Card -->
  <div class="col-12 col-lg-7">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white border-bottom py-3">
        <h5 class="card-title mb-0 fw-bold">
          <i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Edit Profile
        </h5>
      </div>
      <div class="card-body p-4">
        <form
          action="/dashboard/profile?_method=PUT"
          method="POST"
          enctype="multipart/form-data"
          class="needs-validation"
          novalidate
        >
          <!-- Username (editable) -->
          <div class="mb-3">
            <label for="username" class="form-label fw-semibold">Username</label>
            <input
              type="text"
              class="form-control"
              id="username"
              name="username"
              value="<%= user.username %>"
              required
              minlength="3"
              maxlength="50"
            />
            <div class="invalid-feedback">Username must be between 3 and 50 characters.</div>
          </div>

          <!-- Email (read-only) -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Email Address</label>
            <input
              type="email"
              class="form-control bg-light"
              value="<%= user.email %>"
              disabled
            />
            <div class="form-text">Email address cannot be modified.</div>
          </div>

          <!-- Role (read-only) -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Account Role</label>
            <input
              type="text"
              class="form-control bg-light"
              value="<%= roleLabels[user.role] || user.role %>"
              disabled
            />
            <div class="form-text">Role cannot be modified from profile settings.</div>
          </div>

          <!-- Phone (editable) -->
          <div class="mb-3">
            <label for="phone" class="form-label fw-semibold">Phone Number</label>
            <input
              type="tel"
              class="form-control"
              id="phone"
              name="phone"
              value="<%= user.phone || '' %>"
              placeholder="+91XXXXXXXXXX"
              maxlength="20"
            />
            <div class="form-text">Optional contact phone number.</div>
          </div>

          <!-- Bio (editable) -->
          <div class="mb-3">
            <label for="bio" class="form-label fw-semibold">Bio</label>
            <textarea
              class="form-control"
              id="bio"
              name="bio"
              rows="3"
              maxlength="300"
              placeholder="Tell others a little about yourself..."
            ><%= user.bio || '' %></textarea>
            <div class="form-text">Max 300 characters.</div>
          </div>

          <!-- Profile Picture Upload -->
          <div class="mb-3">
            <label for="avatar" class="form-label fw-semibold">
              <%= user.profilePictureUrl ? 'Replace Profile Picture' : 'Upload Profile Picture' %>
            </label>
            <input
              type="file"
              class="form-control"
              id="avatar"
              name="avatar"
              accept="image/*"
            />
            <div class="form-text">Allowed formats: JPEG, PNG, WebP. Maximum file size: 2 MB.</div>
          </div>

          <!-- Remove Picture Checkbox (if picture exists) -->
          <% if (user.profilePictureUrl) { %>
            <div class="form-check mb-4">
              <input
                type="checkbox"
                class="form-check-input"
                id="removeAvatar"
                name="removeAvatar"
                value="true"
              />
              <label class="form-check-label text-danger" for="removeAvatar">
                <i class="fa-solid fa-trash me-1"></i> Remove current profile picture
              </label>
            </div>
          <% } %>

          <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary px-4">
              <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Stub: Password Change (Out of scope for now) -->
    <div class="card border-0 shadow-sm bg-light">
      <div class="card-body p-3 d-flex justify-content-between align-items-center">
        <div>
          <h6 class="mb-1 text-muted fw-bold">
            <i class="fa-solid fa-key me-2"></i>Password & Security
          </h6>
          <small class="text-muted">Password change functionality will be enabled in a future release.</small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" disabled>
          Change Password (Soon)
        </button>
      </div>
    </div>
  </div>
</div>
