<% layout("dashboard/layout") -%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1">
      <i class="fa-solid fa-calendar-check me-2 text-primary"></i>My Bookings
    </h3>
    <p class="text-muted mb-0">Track and manage your upcoming reservations and travel history.</p>
  </div>
</div>

<div class="card border-0 shadow-sm text-center py-5">
  <div class="card-body">
    <div class="mb-3">
      <i class="fa-solid fa-plane-departure text-muted display-4"></i>
    </div>
    <h4 class="fw-bold text-dark">Bookings Feature Coming Soon</h4>
    <p class="text-muted mx-auto" style="max-width: 480px;">
      Direct booking reservations, payment processing, and calendar availability are currently under development. Stay tuned!
    </p>
    <a href="/listings" class="btn btn-outline-primary px-4 mt-2">
      <i class="fa-solid fa-compass me-2"></i>Browse Vacation Listings
    </a>
  </div>
</div>
