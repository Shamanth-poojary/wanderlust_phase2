<nav class="navbar navbar-expand-lg bg-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i class="fa-solid fa-compass"></i></a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left Links -->
      <div class="navbar-nav">
        <a class="nav-link active" aria-current="page" href="/listings">Home</a>
        <% if (typeof canManageListings !== "undefined" && canManageListings) { %>
        <a class="nav-link" href="/listings/new">Add New Listings</a>
        <% } %>
        <% if (typeof currentUser !== "undefined" && currentUser) { %>
        <a class="nav-link" href="/dashboard"><i class="fa-solid fa-gauge me-1"></i>Dashboard</a>
        <% } %>
        <% if (typeof currentUser !== "undefined" && currentUser && currentUser.role === "owner") { %>
        <%
          const statusKey = currentUser.ownerStatus || "none";
          const statusLabels = {
            pending:  "Pending approval",
            approved: "Approved",
            rejected: "Not approved",
            none:     "Application not submitted",
          };
          const badgeClasses = {
            pending:  "bg-warning text-dark",
            approved: "bg-success",
            rejected: "bg-danger",
            none:     "bg-secondary",
          };
        %>
        <a class="nav-link" href="/owner/status">
          Owner Status <span class="badge <%= badgeClasses[statusKey] || 'bg-secondary' %> ms-1"><%= statusLabels[statusKey] || statusKey %></span>
        </a>
        <% } %>
        <% if (typeof currentUser !== "undefined" && currentUser && currentUser.role === "admin") { %>
        <a class="nav-link" href="/dashboard/approvals">
          Owner Applications<% if (typeof pendingOwnerCount === "number" && pendingOwnerCount > 0) { %> <span class="badge bg-danger ms-1"><%= pendingOwnerCount %></span><% } %>
        </a>
        <% } %>
      </div>

      <!-- Right Links -->
      <div class="navbar-nav ms-auto align-items-center">
        <% if (typeof currentUser === "undefined" || !currentUser) { %>
        <a class="nav-link" href="/signup">Register</a>
        <a class="nav-link" href="/login">Login</a>
        <% } else { %>
        <span class="navbar-text me-3 d-flex align-items-center">
          <% if (currentUser.profilePictureUrl) { %>
            <img
              src="<%= currentUser.profilePictureUrl %>"
              alt="<%= currentUser.username %>"
              class="rounded-circle me-2 border"
              style="width: 26px; height: 26px; object-fit: cover;"
            />
          <% } %>
          <span>Hello, <%= currentUser.username %>!</span>
          <% const roleLabels = { customer: "Customer", owner: "Property / Venue Owner", admin: "Admin" }; %>
          <span class="badge bg-secondary ms-1"><%= roleLabels[currentUser.role] || currentUser.role %></span>
        </span>
        <a class="nav-link" href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
