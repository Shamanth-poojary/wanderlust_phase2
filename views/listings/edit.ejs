<% layout("layouts/boilerplate") -%>

<body>
  <div class="row">
    <div class="col-8 offset-2">
      <br /><br />
      <h3>Edit Listing</h3>
      <br />

      <form
        method="POST"
        action="/listings/<%= listing.id %>?_method=PUT"
        enctype="multipart/form-data"
      >
        <!-- TITLE -->
        <div class="mb-3">
          <label class="form-label"><b>TITLE</b></label>
          <input
            type="text"
            name="listing[title]"
            value="<%= listing.title %>"
            class="form-control"
            required
          />
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-3">
          <label class="form-label"><b>DESCRIPTION</b></label>
          <textarea
            name="listing[description]"
            rows="5"
            class="form-control"
            required
          >
<%= listing.description %></textarea
          >
        </div>

        <div class="row">
          <!-- PRICE -->
          <div class="mb-3 col-md-4">
            <label class="form-label"><b>PRICE</b></label>
            <input
              type="number"
              name="listing[price]"
              value="<%= listing.price %>"
              class="form-control"
              min="0"
              step="0.01"
              required
            />
          </div>

          <!-- COUNTRY -->
          <div class="mb-3 col-md-8">
            <label class="form-label"><b>COUNTRY</b></label>
            <input
              type="text"
              name="listing[country]"
              value="<%= listing.country %>"
              class="form-control"
              required
            />
          </div>
        </div>

        <!-- LOCATION -->
        <div class="mb-3">
          <label class="form-label"><b>LOCATION</b></label>
          <input
            type="text"
            name="listing[location]"
            value="<%= listing.location %>"
            class="form-control"
            required
          />
        </div>

        <!-- CURRENT IMAGE PREVIEW -->
        <div class="mb-3">
          <label class="form-label"><b>Current Image</b></label>
          <div>
            <img
              src="<%= listing.image.url %>"
              alt="listing image"
              style="width: 200px; border-radius: 8px"
            />
          </div>
        </div>

        <!-- NEW IMAGE UPLOAD -->
        <div class="mb-3">
          <label class="form-label"><b>Change Image</b></label>
          <input
            type="file"
            name="image"
            class="form-control"
            accept="image/*"
          />
        </div>

        <br />
        <button type="submit" class="btn add-btn">Update</button>
        <br /><br />
      </form>
    </div>
  </div>
</body>
