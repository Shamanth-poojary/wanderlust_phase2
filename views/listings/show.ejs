<% layout("layouts/boilerplate") -%>

  <!-- LISTING TITLE -->
  <h3 class="mt-3">
    <p class="card-text offset-2">
      <b><%= listing.title %></b>
    </p>
  </h3>

  <!-- LISTING CARD -->
  <div class="card offset-2 mt-2 listing-card" style="width: 18rem">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing image"
    />

    <div class="card-body">
      <p class="card-text">
        <!-- F4: Guard missing owner -->
        <b>Owned by: <%= listing.owner ? listing.owner.username : 'unknown' %></b>
      </p>
      <p class="card-text"><%= listing.description %></p>

      <ul class="list-unstyled">
        <li>₹ <%= listing.price.toLocaleString("en-IN") %></li>
        <li><%= listing.country %></li>
        <li><%= listing.location %></li>
      </ul>
    </div>
  </div>

  <% if (typeof currentUser !== 'undefined' && currentUser &&
  currentUser.id === listing.owner.id) { %>
  <!-- EDIT / DELETE BUTTONS -->
  <div class="row mt-3">
    <div class="col-auto offset-2">
      <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark">
        Edit
      </a>
    </div>

    <div class="col-auto">
      <form
        id="deleteForm-<%= listing.id %>"
        method="POST"
        action="/listings/<%= listing.id %>?_method=DELETE"
      >
        <button
          type="button"
          class="btn btn-danger"
          onclick="confirmDelete('<%= listing.id %>')"
        >
          Delete
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- ADD REVIEW FORM -->
  <div class="row mt-4">
    <div class="col-6 offset-2">
      <h4>Leave a Review</h4>

      <!-- F6: Display validation errors above the form -->
      <% if (typeof errors !== 'undefined' && errors && Object.keys(errors).length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% for (const [field, msg] of Object.entries(errors)) { %>
          <li><%= msg %></li>
          <% } %>
        </ul>
      </div>
      <% } %>

      <form
        action="/listings/<%= listing.id %>/reviews"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <!-- RATING SLIDER -->
        <!-- <div class="mb-3">
          <label class="form-label">Rating</label>
          <input
            type="range"
            min="1"
            max="5"
            step="1"
            value="3"
            id="rating"
            name="review[rating]"
            class="form-range"
            required
          />
          <div class="invalid-feedback">
            Please choose a rating between 1 and 5.
          </div> -->
        <div class="mb-3">
          <label class="form-label">Rating</label>
          <fieldset class="starability-coinFlip">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
              checked
            />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>
            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <!-- COMMENT -->
        <div class="mb-3">
          <label class="form-label">Comment</label>
          <textarea
            name="review[comment]"
            class="form-control"
            rows="4"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a comment.</div>
        </div>

        <button class="btn btn-primary">Submit</button>
      </form>
    </div>
  </div>

  <hr />

  <!-- REVIEWS SECTION -->
  <div class="row mt-4">
    <div class="col-8 offset-2">
      <h4>Reviews</h4>

      <% if (listing.reviews.length === 0) { %>
      <p>No reviews yet. Be the first to review!</p>
      <% } else { %>

      <div class="row">
        <% for (let review of listing.reviews) { %> <% if (review) { %>

        <div class="card col-5 mb-3 ms-3">
          <div class="card-body">
            <h6 class="card-title mt-1"><%=review.owner.username%></h6>
            <!-- STAR RATING -->
            <!-- <div class="rating text-warning fs-5 mb-1">
              <% for (let i = 1; i <= 5; i++) { %> <%= i <= review.rating ? "★"
              : "☆" %> <% } %>
            </div> -->
            <p class="starability-result" data-rating="<%= review.rating %>">
              Rated: 3 stars
            </p>

            <p class="card-text"><%= review.comment %></p>

            <small class="text-muted">
              Reviewed on <%= review.createdAt instanceof Date ? review.createdAt.toDateString() : new Date(review.createdAt).toDateString() %>
            </small>
          </div>
          <form
            method="POST"
            action="/listings/<%=listing.id%>/reviews/<%=review.id%>?_method=DELETE"
            id="deleteForm-<%= review.id %>"
          >
            <% if (typeof currentUser !== 'undefined' && currentUser &&
            currentUser.id === review.owner.id) { %>
            <button
              class="btn btn-dark mt-3 mb-2"
              onclick="confirmDelete('<%=review.id%>')"
              type="button"
            >
              Delete
            </button>
            <% } %>
          </form>
        </div>

        <% } %> <% } %>
      </div>

      <% } %>
    </div>

   <div class="col-6 offset-2 mb-3">
  <h3>Where you will be</h3>

  <!-- F4: Guard against missing geometry – coordinates script is now inside this block -->
  <% if (
    listing.geometry &&
    listing.geometry.coordinates &&
    listing.geometry.coordinates.length === 2
  ) { %>
    <script>
      let mapToken = "<%= process.env.MAP_TOKEN %>";
      const coordinates = JSON.parse('<%- JSON.stringify(listing.geometry.coordinates) %>');
    </script>

    <!-- Map Available -->
    <button id="loadMapBtn" class="btn btn-dark mb-3">
      Load Map 📍
    </button>

    <div
      id="map"
      data-token="<%= process.env.MAP_TOKEN %>"
      data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
      style="display: none;"
    ></div>

  <% } else { %>

    <!-- No Map -->
    <div class="alert alert-secondary">
      📍 No map added yet for this listing.
    </div>

  <% } %>
</div>


  <!-- DELETE CONFIRMATION -->
  <script>
    function confirmDelete(id) {
      if (confirm("Are you sure you want to delete this item?")) {
        document.getElementById("deleteForm-" + id).submit();
      }
    }
  </script>